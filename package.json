{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint --cache --concurrency auto src scripts e2e vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/domain src/utils src/hooks --pool=threads --maxWorkers=1",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:db": "node scripts/validate-logic-migration.mjs",
    "import:april-master": "node scripts/import-april-2026-master-data.mjs",
    "import:april-routes": "node scripts/import-april-2026-route-locations.mjs",
    "fix:april-shipment-master": "node scripts/fix-april-2026-shipment-master-blockers.mjs",
    "import:april-shipments": "node scripts/import-april-2026-shipments.mjs",
    "import:april-expenses": "node scripts/import-april-2026-expenses.mjs",
    "import:previous-shipments": "node scripts/import-previous-shipments.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@vitejs/plugin-react": "latest",
    "html2canvas": "^1.4.1",
    "lucide-react": "latest",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "read-excel-file": "^9.3.1",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
